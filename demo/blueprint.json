{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Cărți digitale Paralela 45 – demo",
		"description": "Pluginul Cărți digitale, cu două cărți demo, un cont de profesor și panoul editurii.",
		"author": "tudorvictoremanuel"
	},
	"landingPage": "/intra/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/tudorvictoremanuel/resurse-educationale/main/demo/p45-carti-digitale.zip"
			},
			"options": {
				"activate": true
			},
			"progress": {
				"caption": "Instalez platforma"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/p45-demo.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/tudorvictoremanuel/resurse-educationale/main/demo/p45-demo.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/tmp/p45-instaleaza-demo.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/tudorvictoremanuel/resurse-educationale/main/demo/instaleaza-demo.php"
			}
		},
		{
			"step": "unzip",
			"zipFile": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/tudorvictoremanuel/resurse-educationale/main/demo/continut-demo.zip"
			},
			"extractToPath": "/tmp/p45-demo"
		},
		{
			"step": "runPHP",
			"code": "<?php require_once '/wordpress/wp-load.php'; require '/tmp/p45-instaleaza-demo.php';",
			"progress": {
				"caption": "Pregătesc cărțile demo"
			}
		}
	]
}
